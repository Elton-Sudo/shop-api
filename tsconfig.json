{
  "compilerOptions": {
    "target": "ES2020", // Set the JavaScript version to compile to
    "module": "ESNext", // Use ESNext or CommonJS modules
    "strict": true, // Enable strict type-checking
    "esModuleInterop": true, 
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
